<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Dashboard"
             xmlns:si="using:formatrack.Services.Interfaces"
             xmlns:models="using:formatrack.Models"
             xmlns:local="using:formatrack.Views.Dashboard"
             x:Class="formatrack.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#1B2A4A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6B8C" />
        <SolidColorBrush x:Key="GoldBrush" Color="#B8935F" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EC" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource NavyPrimaryBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="34" Spacing="24">
            <!-- Header Section -->
            <StackPanel>
                <Rectangle Width="42" Height="3" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
                <TextBlock Text="Tableau de bord" Foreground="{StaticResource NavyBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="16" />
            </StackPanel>

            <!-- ===== STAGIAIRE: Personal alerts & remarks ===== -->
            <Border IsVisible="{Binding IsStagiaireView}" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚠️ Mes Alertes" FontSize="16" FontWeight="SemiBold" Foreground="#B91C1C" />
                            <TextBlock Text="{Binding StagiaireAlerts}" TextWrapping="Wrap" FontSize="14" Foreground="#991B1B" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📋 Mes Remarques" FontSize="16" FontWeight="SemiBold" Foreground="#92400E" />
                            <TextBlock Text="{Binding StagiaireRemarks}" TextWrapping="Wrap" FontSize="14" Foreground="#78350F" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== KPI Section (Admin, Formateur, ChefDep) ===== -->
            <Grid ColumnDefinitions="3*,2*" Margin="0,0,0,10" IsVisible="{Binding !IsStagiaireView}">
                <UniformGrid Grid.Column="0" Columns="2" Rows="2" Margin="0,0,16,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding FormationsCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Text="Formations actives" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SessionsCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Text="Sessions programmées" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding UtilisateursCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Text="Utilisateurs enregistrés" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TauxReussite}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Text="Taux de réussite" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- AHP Panel (Admin only) -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" IsVisible="{Binding IsAdminView}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📊 Taux de Réussite par Promotion" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Taux global :" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                                <TextBlock Text="{Binding AhpCompositeScore}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Toutes formations :" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding TauxReussite}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Separator Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                        <TextBlock Text="Analyse automatique :" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <TextBlock Text="{Binding RecommendationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ChefDep: Department monitoring panel -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" IsVisible="{Binding IsChefDepView}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📊 Monitoring du Département" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Formateurs" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding DeptFormateursCount}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Stagiaires" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding DeptStagiairesCount}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Separator Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                        <TextBlock Text="{Binding RecommendationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ResponsableFormation: Formations overview panel -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" IsVisible="{Binding IsResponsableFormationView}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📋 Vue d'ensemble des Formations" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Formations" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding FormationsCount}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Sessions" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SessionsCount}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Separator Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                        <TextBlock Text="{Binding RecommendationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Decideur: Decision-making panel -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" IsVisible="{Binding IsDecideurView}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📊 Taux de Réussite par Promotion" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Taux global :" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                                <TextBlock Text="{Binding AhpCompositeScore}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Toutes formations :" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding TauxReussite}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Separator Height="1" Background="{StaticResource BorderBrush}" Margin="0,4" />
                        <TextBlock Text="Analyse décisionnelle :" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <TextBlock Text="{Binding RecommendationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                        <Button Classes="outline" Content="Exporter le rapport" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Decision Support: Suggestions Panel (Admin + Decideur) ===== -->
            <Border IsVisible="{Binding IsAdminView}" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="💡 Système d'Aide à la Décision" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,3">
                                <TextBlock Text="{Binding SuggestionsStatus}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline" Content="↻ Actualiser" Command="{Binding RefreshSuggestionsCommand}"
                                IsEnabled="{Binding !IsSuggestionsLoading}" MinHeight="32" Padding="12,4" FontSize="13" />
                    </Grid>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,6"
                            IsVisible="{Binding IsSuggestionsLoading}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Analyse de la base de données en cours..." FontSize="13" Foreground="#B91C1C" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SuggestionAide">
                                    <Border x:CompileBindings="False"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="14,12" Cursor="Hand" Background="White"
                                            PointerPressed="OnSuggestionClick" Tag="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <!-- Priority indicator -->
                                            <Border Grid.Column="0" Grid.RowSpan="2" Width="6" CornerRadius="3"
                                                    Margin="0,0,12,0" VerticalAlignment="Stretch"
                                                    Background="{Binding Priorite, Converter={x:Static local:SuggestionPriorityConverter.Instance}}" />

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1" Grid.Row="0"
                                                       Text="{Binding Titre}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{Binding EstLu, Converter={x:Static local:SuggestionTextConverter.Instance}}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500" />

                                            <!-- Description -->
                                            <TextBlock Grid.Column="1" Grid.Row="1"
                                                       Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" MaxWidth="500" Margin="0,4,0,0"
                                                       Opacity="{Binding EstLu, Converter={x:Static local:SuggestionDescOpacityConverter.Instance}}" />

                                            <!-- Action badge -->
                                            <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Background="{Binding Priorite, Converter={x:Static local:SuggestionBadgeConverter.Instance}}"
                                                        CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding PrioriteLabel}" FontSize="11" FontWeight="Medium" Foreground="White" />
                                                </Border>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding ActionPage}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== Formateur: Class stats row ===== -->
            <Border IsVisible="{Binding IsFormateurView}" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="📈 Statistiques de la Classe" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Moyenne" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ClassAverage}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Taux réussite" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ClassPassRate}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Meilleur" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ClassBestStudent}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="À suivre" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ClassWorstStudent}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Tabs ===== -->
            <TabControl Background="Transparent" BorderThickness="0" Padding="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Tab 1: Emploi du temps (Admin, Formateur, ChefDep - NOT Stagiaire) -->
                <TabItem Header="📅 Emploi du temps" IsVisible="{Binding !IsStagiaireView}">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                        <StackPanel Spacing="14">
                            <ItemsControl ItemsSource="{Binding ProchainesSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Session">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid ColumnDefinitions="*,150,120">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding TitreFormation}" FontWeight="SemiBold" Foreground="#1B2432" FontSize="16" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Lieu}" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                                                        <TextBlock Text="•" Foreground="{StaticResource BorderMediumBrush}" />
                                                        <TextBlock Text="{Binding Statut}" Foreground="{StaticResource GoldBrush}" FontSize="14" FontWeight="Medium" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Periode}" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Classes="outline" Content="Détails" MinHeight="36" Padding="12,6" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Tab 2: Notes & Évaluations -->
                <TabItem Header="📝 Notes &amp; Évaluations">
                    <Grid ColumnDefinitions="*" Margin="0,10,0,0" RowDefinitions="Auto,*">
                        <!-- Search Filters -->
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Filtrer les notes :" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Width="300" Height="36" Watermark="Rechercher par stagiaire ou matière..." Text="{Binding StudentFilter, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="outline" Content="Exporter CSV" MinHeight="32" Padding="12,6" FontSize="13" VerticalAlignment="Center"
                                        IsVisible="{Binding CanExport}" />
                            </Grid>
                        </Border>

                        <!-- Evaluations List -->
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <ScrollViewer MaxHeight="500">
                                <ItemsControl ItemsSource="{Binding FilteredEvaluations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Evaluation">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding QuestionnaireTitre}" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="16" />
                                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding TypeEvaluation}">
                                                                <TextBlock Text="{Binding TypeEvaluation}" FontSize="11" FontWeight="Medium" Foreground="#1D4ED8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding UtilisateurNom, StringFormat='Stagiaire : {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScoreTotal, StringFormat='{}{0}/20'}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding Pourcentage, StringFormat='{}{0:0.0}%'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0" Spacing="12">
                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding MoyenneClasse, StringFormat='Moyenne classe: {0:0.0}/20'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <Border Background="#FEF2F2" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding NoteMin, StringFormat='Note Min: {0:0.0}/20'}" FontSize="12" Foreground="{StaticResource DangerRedBrush}" />
                                                        </Border>
                                                        <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding NoteMax, StringFormat='Note Max: {0:0.0}/20'}" FontSize="12" Foreground="{StaticResource SuccessGreenBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Absences & Retards (All roles) -->
                <TabItem Header="⚠️ Absences &amp; Retards">
                    <Grid ColumnDefinitions="2*,*" Margin="0,10,0,0">
                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,16,0">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Historique des Absences &amp; Retards" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" />
                                <ItemsControl ItemsSource="{Binding AbsenceRetardList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AbsenceRetard">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding Cours}" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="15" />
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding Date}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                                            <TextBlock Text="•" Foreground="{StaticResource BorderMediumBrush}" />
                                                            <TextBlock Text="{Binding Duree}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Justification, StringFormat='Justification : {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontStyle="Italic" IsVisible="{Binding Justifiee}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding IsAbsenceJustified}">
                                                        <TextBlock Text="Justifiée" Foreground="{StaticResource SuccessGreenBrush}" FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding IsAbsenceUnjustified}">
                                                        <TextBlock Text="Non justifiée" Foreground="{StaticResource DangerRedBrush}" FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding IsRetard}">
                                                        <TextBlock Text="Retard (Signalé)" Foreground="{StaticResource WarningAmberBrush}" FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Button Grid.Column="2" Classes="outline" Content="Justifier" 
                                                            Command="{Binding $parent[UserControl].DataContext.SetSelectedAbsenceCommand}" 
                                                            CommandParameter="{Binding}"
                                                            MinHeight="32" Padding="10,4" FontSize="13" VerticalAlignment="Center"
                                                            IsVisible="{Binding !Justifiee}"
                                                            x:CompileBindings="False" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Justifier une Absence" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" />
                                <StackPanel Spacing="8" IsVisible="{Binding SelectedAbsence, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Session sélectionnée :" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedAbsence.Cours}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource NavyPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedAbsence.Date}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Motif réglementaire" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding Motifs}" SelectedItem="{Binding SelectedMotif}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Détails de la justification" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding JustificationText, Mode=TwoWay}" Watermark="Saisir la justification officielle..." AcceptsReturn="True" Height="100" />
                                    </StackPanel>
                                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsErrorVisible}">
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerRedBrush}" FontSize="13" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding AutoSaveStatus}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontStyle="Italic" HorizontalAlignment="Right" />
                                    <Button Classes="primary" Content="Enregistrer" Command="{Binding JustifierCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock Text="Sélectionnez une absence non justifiée dans la liste pour saisir son motif."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,40,0,0"
                                           IsVisible="{Binding SelectedAbsence, Converter={x:Static ObjectConverters.IsNull}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 4: Messagerie & Alertes (All roles) -->
                <TabItem Header="✉️ Messagerie &amp; Alertes">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Filtrer les messages :" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Width="300" Height="36" Watermark="Rechercher par mot-clé..." Text="{Binding SearchText, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Notifications du jour &amp; Alertes système" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontStyle="Italic" />
                            </Grid>
                            <Separator Height="1" Background="{StaticResource BorderBrush}" />
                            <ScrollViewer MaxHeight="400">
                                <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Notification">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Message}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DateCreation, StringFormat='{}{0:g}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
