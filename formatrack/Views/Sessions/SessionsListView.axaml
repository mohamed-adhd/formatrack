<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Sessions"
             xmlns:models="using:formatrack.Models"
             x:Class="formatrack.Views.Sessions.SessionsListView"
             x:DataType="vm:SessionsListViewModel"
             Background="{StaticResource BackgroundPageBrush}">

    <Grid RowDefinitions="Auto,*" Margin="32,24,32,32">

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <Rectangle Width="42" Height="3.5" Fill="{StaticResource GoldAccentBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Sessions d'Enseignement" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBox Width="280" Height="40" Watermark="Rechercher une session..." Text="{Binding Recherche, Mode=TwoWay}" />
                <Button Classes="outline" Content="Actualiser" Command="{Binding RefreshCommand}" Height="40" Padding="14,0" />
                <Button Classes="primary" Content="+ Planifier une Session" Command="{Binding OpenCreateCommand}" Height="40" Padding="16,0" />
            </StackPanel>
        </Grid>

        <!-- Sessions List Items -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Session" x:CompileBindings="False">
                        <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,0,14" BoxShadow="0 2 8 0 #08000000">
                            <Grid ColumnDefinitions="*,180,110,120,100">

                                <!-- Formation & Lieu -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#FEF3C7" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconSessions}" Width="14" Height="14" Foreground="{StaticResource GoldDarkBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding TitreFormation}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconLocation}" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Lieu}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Periode Dates -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Période programmée" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconClock}" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Periode}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Capacite -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Effectif max" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding Capacite, StringFormat='{}{0} stagiaires'}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>

                                <!-- Statut -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Statut" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Statut}" Foreground="{StaticResource GoldDarkBrush}" FontWeight="Bold" FontSize="14" />
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <Button Grid.Column="4" Classes="outline" Content="Détails →"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Height="34" Padding="12,0" FontSize="14" FontWeight="SemiBold"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
