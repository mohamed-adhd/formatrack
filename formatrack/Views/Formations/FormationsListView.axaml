<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Formations"
             xmlns:models="using:formatrack.Models"
             x:Class="formatrack.Views.Formations.FormationsListView"
             x:DataType="vm:FormationsListViewModel"
             Background="{StaticResource BackgroundPageBrush}">

    <Grid RowDefinitions="Auto,*" Margin="32,24,32,32">

        <!-- Top Header & Search/Action Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <Rectangle Width="42" Height="3.5" Fill="{StaticResource GoldAccentBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Répertoire des Formations" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBox Width="280" Height="40" Watermark="Rechercher une formation..." Text="{Binding Recherche, Mode=TwoWay}" />
                <Button Classes="outline" Content="Actualiser" Command="{Binding RefreshCommand}" />
                <Button Classes="primary" Content="+ Nouvelle Formation" Command="{Binding OpenCreateCommand}" />
            </StackPanel>
        </Grid>

        <!-- Formations Card Grid -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Formations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Formation" x:CompileBindings="False">
                        <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,0,14" BoxShadow="0 2 8 0 #08000000">
                            <Grid ColumnDefinitions="*,130,130,120,100">

                                <!-- Formation Title & Info -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#EBF3FC" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconFormations}" Width="14" Height="14" Foreground="{StaticResource NavyPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NavyPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{Binding Objectifs, StringFormat='Objectifs : {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" MaxLines="1" />
                                </StackPanel>

                                <!-- Duration Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Volume horaire" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconClock}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Duree}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Type Badge -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Domaine" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeFormation}" Foreground="{StaticResource NavyPrimaryBrush}" FontWeight="SemiBold" FontSize="14" />
                                    </Border>
                                </StackPanel>

                                <!-- Status Badge -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Statut" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Statut}" Foreground="{StaticResource SuccessGreenBrush}" FontWeight="SemiBold" FontSize="14" />
                                    </Border>
                                </StackPanel>

                                <!-- Action Button -->
                                <Button Grid.Column="4" Classes="outline" Content="Détails →"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MinHeight="36" Padding="12,6" FontSize="14" FontWeight="SemiBold"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
