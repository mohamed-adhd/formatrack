<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Timetable"
             xmlns:models="using:formatrack.Models"
             x:Class="formatrack.Views.Timetable.TimetableView"
             x:DataType="vm:TimetableViewModel"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#1B2A4A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6B8C" />
        <SolidColorBrush x:Key="GoldBrush" Color="#B8935F" />
        <SolidColorBrush x:Key="CellBorderBrush" Color="#E3E6EC" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="34" Spacing="16">
            <StackPanel>
                <Rectangle Width="42" Height="3" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
                <TextBlock Text="Emploi du Temps &amp; Chronogramme" Foreground="{StaticResource NavyBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
            </StackPanel>

            <Border Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="Affichage :" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <RadioButton Grid.Column="1" Content="Hebdomadaire" Command="{Binding SetWeeklyCommand}" GroupName="ViewMode" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <RadioButton Grid.Column="2" Content="Annuel (Chronogramme)" Command="{Binding SetYearlyCommand}" GroupName="ViewMode" FontSize="14" VerticalAlignment="Center" />
                    <Panel Grid.Column="3" />
                    <Button Grid.Column="4" Classes="outline" Content="Ajouter" Command="{Binding PickImageCommand}" FontSize="14" MinHeight="34" Padding="12,4"
                            IsVisible="{Binding CanManage}" />
                </Grid>
            </Border>

            <Border IsVisible="{Binding CanManage}" Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nouvel Emploi du Temps" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Formation" FontSize="13" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox ItemsSource="{Binding Formations}" SelectedItem="{Binding SelectedFormation}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Formation">
                                        <TextBlock Text="{Binding Titre}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Type" FontSize="13" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox ItemsSource="{Binding TypesEmploi}" SelectedItem="{Binding SelectedTypeEmploi}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4">
                            <TextBlock Text="Annee cible" FontSize="13" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox ItemsSource="{Binding Annees}" SelectedItem="{Binding SelectedAnnee}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBox Grid.ColumnSpan="3" Grid.Row="1" Text="{Binding UploadDescription}" Watermark="Description (optionnel)" Margin="0,8,0,0" />
                        <Border Grid.ColumnSpan="3" Grid.Row="2" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsUploadErrorVisible}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UploadError}" Foreground="#B91C1C" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <Button Grid.ColumnSpan="3" Grid.Row="3" Classes="primary" Content="Publier l'emploi du temps" Command="{Binding UploadEmploiCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="300,*" RowDefinitions="Auto">
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Liste des emplois du temps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                        <ScrollViewer MaxHeight="500">
                            <ItemsControl ItemsSource="{Binding FilteredEmplois}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmploiDuTemps">
                                        <Border BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="0,0,0,1" Padding="10,10" Cursor="Hand" Background="White">
                                            <StackPanel Spacing="4" x:CompileBindings="False">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding FormationTitre}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding TypeEmploi}" FontSize="11" FontWeight="Medium" Foreground="#1D4ED8" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Annee}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Statut}" FontSize="11" FontWeight="Medium" Foreground="#059669" />
                                                    </Border>
                                                    <Button Classes="outline" Content="Afficher" Tag="{Binding}" Click="OnAfficherClick" FontSize="12" MinHeight="26" Padding="8,2" x:CompileBindings="False" />
                                                    <Button Classes="outline" Content="Publier" Tag="{Binding}" Click="OnTogglePublishClick" FontSize="12" MinHeight="26" Padding="8,2"
                                                            IsVisible="{Binding $parent[UserControl].DataContext.CanManage}" x:CompileBindings="False" />
                                                    <Button Classes="outline" Content="Supprimer" Tag="{Binding}" Click="OnDeleteClick" FontSize="12" MinHeight="26" Padding="8,2"
                                                            IsVisible="{Binding $parent[UserControl].DataContext.CanManage}" x:CompileBindings="False" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Zoom :" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center" />
                                <Button Classes="outline" Content="-" Command="{Binding ZoomOutCommand}" FontSize="16" MinWidth="36" MinHeight="30" Padding="0" />
                                <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:0%}'}" FontSize="14" VerticalAlignment="Center" MinWidth="50" TextAlignment="Center" />
                                <Button Classes="outline" Content="+" Command="{Binding ZoomInCommand}" FontSize="16" MinWidth="36" MinHeight="30" Padding="0" />
                                <Button Classes="outline" Content="Réinitialiser" Command="{Binding ResetZoomCommand}" FontSize="13" MinHeight="30" Padding="10,0" />
                            </StackPanel>
                            <Panel Grid.Column="1" Width="12" />
                            <Button Grid.Column="2" Classes="outline" Content="🖨 Imprimer" Command="{Binding PrintImageCommand}" FontSize="13" MinHeight="30" Padding="10,4" />
                            <Panel Grid.Column="3" />
                            <Button Grid.Column="4" Classes="outline" Content="💾 Exporter" Command="{Binding ExportImageCommand}" FontSize="13" MinHeight="30" Padding="10,4" />
                            <Panel Grid.Column="5" Width="4" />
                        </Grid>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="8" MinHeight="400">
                            <Border ClipToBounds="True">
                                <Panel>
                                    <TextBlock Text="Sélectionnez un emploi du temps dans la liste"
                                               IsVisible="{Binding !SelectedEmploiImage}"
                                               FontSize="16" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding SelectedEmploiImage}">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Background="White" BorderBrush="{StaticResource CellBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Image Source="{Binding SelectedEmploiImage}"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       Stretch="Uniform"
                                                       MinWidth="400" MinHeight="300">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>
                                        </Panel>
                                    </ScrollViewer>
                                </Panel>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
