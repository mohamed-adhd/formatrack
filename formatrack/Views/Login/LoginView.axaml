<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels"
             x:Class="formatrack.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource BackgroundPageBrush}">

    <Grid>
        <!-- Background Decorative Tone -->
        <Border Background="{StaticResource BackgroundPageBrush}" />

        <!-- Top Right Window Actions -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,24,0"
                    ZIndex="10">
            <Button Name="FullScreenButton"
                    Classes="ghost"
                    Content="Plein écran"
                    Click="OnToggleFullScreenClick" />
            <TextBlock Text="|" Foreground="{StaticResource BorderMediumBrush}" VerticalAlignment="Center" />
            <Button Classes="ghost"
                    Content="Quitter"
                    Command="{Binding QuitterCommand}" />
        </StackPanel>

        <!-- Centered Main Login Container Card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="860"
                MinHeight="500"
                Background="White"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="16"
                BoxShadow="0 16 48 -12 #20000000">

            <Grid ColumnDefinitions="360,*">

                <!-- Left Panel: Institutional Brand & Mission -->
                <Border Grid.Column="0"
                        Background="{StaticResource NavyDarkBrush}"
                        CornerRadius="15,0,0,15"
                        Padding="36">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Top Brand Header -->
                        <StackPanel Grid.Row="0" Spacing="14">
                            <Border Width="52" Height="52" CornerRadius="12"
                                    Background="{StaticResource NavyPrimaryBrush}"
                                    BorderBrush="{StaticResource GoldAccentBrush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Left">
                                <PathIcon Data="{StaticResource IconShield}" Width="26" Height="26"
                                          Foreground="{StaticResource GoldAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="3">
                                <TextBlock Text="CMFPO"
                                           FontSize="26" FontWeight="SemiBold"
                                           Foreground="White"
                                           LetterSpacing="1.5" />
                                <TextBlock Text="CENTRE MILITAIRE DE FORMATION PROFESSIONNEL DE L'OMRAN"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource GoldAccentBrush}"
                                           LetterSpacing="2" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Center Info Points -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
                            <TextBlock Text="Système d'Évaluation de la Formation et d'Aide à la Décision"
                                       FontSize="16"
                                       Foreground="#B0C2DE"
                                       TextWrapping="Wrap" />

                            <Rectangle Height="1" Fill="#1E3A66" HorizontalAlignment="Stretch" Margin="0,4" />

                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconAward}" Width="15" Height="15" Foreground="{StaticResource GoldAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Évaluation multicritères &amp; scoring AHP" Margin="10,0,0,0" Foreground="#D5E2F5" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconFormations}" Width="15" Height="15" Foreground="{StaticResource GoldAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Suivi pédagogique &amp; sessions d'études" Margin="10,0,0,0" Foreground="#D5E2F5" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconStatistiques}" Width="15" Height="15" Foreground="{StaticResource GoldAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Pilotage stratégique pour le Commandement" Margin="10,0,0,0" Foreground="#D5E2F5" FontSize="16" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom Institutional Footer -->
                        <TextBlock Grid.Row="2"
                                   Text="Direction des Études • Promotion 2026"
                                   FontSize="16"
                                   Foreground="#6B82A6" />
                    </Grid>
                </Border>

                <!-- Right Panel: Login Form -->
                <Border Grid.Column="1" Padding="44,36">
                    <StackPanel Spacing="0" VerticalAlignment="Center">

                        <Rectangle Width="36" Height="3" Fill="{StaticResource GoldAccentBrush}"
                                   HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Margin="0,0,0,16" />

                        <TextBlock Text="Espace de Connexion"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyPrimaryBrush}" />

                        <TextBlock Text="Veuillez vous authentifier pour accéder à la plateforme."
                                   FontSize="16"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,20" />

                        <!-- Quick Demo Credentials Chips -->
                        <TextBlock Text="COMPTES DE TEST (1 CLIC) :" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" LetterSpacing="0.8" />
                        <WrapPanel Margin="0,0,0,18">
                            <Button Classes="outline" Content="👑 Admin" Command="{Binding FillAdminCommand}" Margin="0,0,6,6" FontSize="16" />
                            <Button Classes="outline" Content="🏛️ Chef Dép." Command="{Binding FillChefDepartementCommand}" Margin="0,0,6,6" FontSize="16" />
                            <Button Classes="outline" Content="🎓 Formateur" Command="{Binding FillFormateurCommand}" Margin="0,0,6,6" FontSize="16" />
                            <Button Classes="outline" Content="🎖️ Stagiaire" Command="{Binding FillStagiaireCommand}" Margin="0,0,6,6" FontSize="16" />
                            <Button Classes="outline" Content="📋 Resp. Formation" Command="{Binding FillResponsableFormationCommand}" Margin="0,0,6,6" FontSize="16" />
                            <Button Classes="outline" Content="📊 Décideur" Command="{Binding FillDecideurCommand}" Margin="0,0,6,6" FontSize="16" />
                        </WrapPanel>

                        <!-- Identifiant Input -->
                        <TextBlock Text="Identifiant / Email institutionnel" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Identifiant, Mode=TwoWay}"
                                 Watermark="ex: admin@cmfpo.local" />

                        <!-- Mot de passe Input -->
                        <TextBlock Text="Mot de passe" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,6" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding MotDePasse, Mode=TwoWay}"
                                     Watermark="Votre mot de passe"
                                     PasswordChar="{Binding PasswordChar}" />
                            <Button Grid.Column="1"
                                    Classes="outline"
                                    Content="{Binding EyeIcon}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Margin="6,0,0,0" />
                        </Grid>

                        <!-- Error Banner -->
                        <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,12,0,0"
                                IsVisible="{Binding IsErrorVisible}">
                            <TextBlock Text="{Binding MessageErreur}"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Submit Button -->
                        <Button Classes="primary"
                                 Content="Se connecter à CMFPO"
                                Command="{Binding SeConnecterCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="16"
                                Margin="0,20,0,0" />

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
