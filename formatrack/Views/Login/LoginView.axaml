<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels"
             x:Class="formatrack.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="#FFFFFF">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#1B2A4A" />
        <SolidColorBrush x:Key="NavyMutedBrush" Color="#5A6B8C" />
        <SolidColorBrush x:Key="GoldBrush" Color="#B8935F" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EC" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
        <SolidColorBrush x:Key="FieldBackground" Color="#F7F8FA" />

        <Style Selector="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource FieldBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#243458" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NavyMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{StaticResource NavyBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Quit button, top-right corner -->
        <Button Classes="ghost"
                Content="Quitter"
                Command="{Binding QuitterCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,32,0" />

        <!-- Centered login card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380"
                Padding="40,40,40,32"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 8 24 -6 #14000000">

            <StackPanel Spacing="0">

                <!-- Signature accent: single thin gold rule above the title -->
                <Rectangle Width="36" Height="3" Fill="{StaticResource GoldBrush}"
                           HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Margin="0,0,0,20" />

                <TextBlock Text="Bienvenue sur SEFAD"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NavyBrush}" />

                <TextBlock Text="Système d'Évaluation de la Formation et d'Aide à la Décision"
                           FontSize="13"
                           Foreground="{StaticResource NavyMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,28" />

                <TextBlock Text="Identifiant" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Identifiant, Mode=TwoWay}"
                         Watermark="Votre identifiant" />

                <TextBlock Text="Mot de passe" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource NavyBrush}" Margin="0,16,0,6" />
                <TextBox Text="{Binding MotDePasse, Mode=TwoWay}"
                         Watermark="Votre mot de passe"
                         PasswordChar="•" />

                <!-- Error message: visibility bound to IsErrorVisible -->
                <TextBlock Text="{Binding MessageErreur}"
                           IsVisible="{Binding IsErrorVisible}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Button Classes="primary"
                        Content="Se connecter"
                        Command="{Binding SeConnecterCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,22,0,10" />

                <Button Classes="secondary"
                        Content="Créer un compte"
                        Command="{Binding CreerCompteCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
