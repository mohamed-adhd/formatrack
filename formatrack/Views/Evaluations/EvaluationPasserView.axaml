<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Evaluations"
             x:Class="formatrack.Views.Evaluations.EvaluationPasserView"
             x:DataType="vm:EvaluationPasserViewModel"
             Background="{StaticResource BackgroundPageBrush}">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Top Header & Progress -->
            <StackPanel Spacing="10">
                <Button Classes="ghost" Command="{Binding OpenDashboardCommand}" Padding="0" Margin="0,0,0,4">
                    <TextBlock Text="← Abandonner et retourner au menu" Foreground="{StaticResource GoldDarkBrush}" FontSize="14" FontWeight="SemiBold" />
                </Button>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Questionnaire.Titre, FallbackValue='Formulaire d\'Évaluation'}"
                                   Foreground="{StaticResource NavyPrimaryBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF3FC" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}% complété'}" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="14" FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- Linear Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" CornerRadius="3"
                             Foreground="{StaticResource GoldAccentBrush}" Background="#E2E8F0" />
            </StackPanel>

            <!-- Active Question Card -->
            <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="32" BoxShadow="0 4 16 0 #0C000000">
                <StackPanel Spacing="22">

                    <!-- Question Header & Badges -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Background="{StaticResource NavyPrimaryBrush}" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding CurrentQuestion.Ordre, StringFormat='Question #{0}'}" Foreground="{StaticResource GoldAccentBrush}" FontSize="14" FontWeight="Bold" />
                        </Border>

                        <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding CurrentQuestion.Bareme, StringFormat='Barème : {0} pts'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Question Prompt / Text -->
                    <TextBlock Text="{Binding CurrentQuestion.Enonce}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                    <Rectangle Height="1" Fill="{StaticResource BorderLightBrush}" HorizontalAlignment="Stretch" />

                    <!-- Quick Rating Scale (1 to 5) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="ÉVALUATION SUR ÉCHELLE (1 À 5) :" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
                        <UniformGrid Columns="5">
                            <Button Classes="outline" Content="1 - Très faible" Command="{Binding SetRatingCommand}" CommandParameter="1" Margin="0,0,4,0" Height="40" FontSize="14" />
                            <Button Classes="outline" Content="2 - Insatisfaisant" Command="{Binding SetRatingCommand}" CommandParameter="2" Margin="4,0,4,0" Height="40" FontSize="14" />
                            <Button Classes="outline" Content="3 - Moyen" Command="{Binding SetRatingCommand}" CommandParameter="3" Margin="4,0,4,0" Height="40" FontSize="14" />
                            <Button Classes="outline" Content="4 - Satisfaisant" Command="{Binding SetRatingCommand}" CommandParameter="4" Margin="4,0,4,0" Height="40" FontSize="14" />
                            <Button Classes="outline" Content="5 - Excellent" Command="{Binding SetRatingCommand}" CommandParameter="5" Margin="4,0,0,0" Height="40" FontSize="14" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- Text Response Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="RÉPONSE DÉTAILLÉE / OBSERVATIONS :" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
                        <TextBox Text="{Binding ReponseTexte, Mode=TwoWay}"
                                 Watermark="Saisissez votre note, appréciation ou argumentation..."
                                 AcceptsReturn="True"
                                 Height="100" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{StaticResource BorderLightBrush}" HorizontalAlignment="Stretch" />

                    <!-- Navigation & Submission Controls -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="outline" Content="← Question précédente"
                                Command="{Binding PreviousQuestionCommand}"
                                IsEnabled="{Binding !IsFirstQuestion}"
                                Height="42" Padding="16,0" />

                        <!-- Next / Submit Button on the Right -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Classes="primary" Content="Question suivante →"
                                    Command="{Binding NextQuestionCommand}"
                                    IsVisible="{Binding !IsLastQuestion}"
                                    Height="42" Padding="20,0" />

                            <Button Classes="gold" Content="✓ Finaliser &amp; Soumettre l'Évaluation"
                                    Command="{Binding SubmitCommand}"
                                    IsVisible="{Binding IsLastQuestion}"
                                    Height="42" Padding="22,0" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
