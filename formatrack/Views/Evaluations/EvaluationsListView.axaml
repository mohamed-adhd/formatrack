<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:formatrack.ViewModels.Evaluations"
             xmlns:models="using:formatrack.Models"
             x:Class="formatrack.Views.Evaluations.EvaluationsListView"
             x:DataType="vm:EvaluationsListViewModel"
             Background="{StaticResource BackgroundPageBrush}">

    <Grid RowDefinitions="Auto,*" Margin="32,24,32,32">

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <Rectangle Width="42" Height="3.5" Fill="{StaticResource GoldAccentBrush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Historique des Évaluations &amp; Restitutions" Foreground="{StaticResource NavyPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMutedBrush}" FontSize="16" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBox Width="280" Height="40" Watermark="Rechercher par stagiaire, questionnaire..." Text="{Binding Recherche, Mode=TwoWay}" />
                <Button Classes="outline" Content="Actualiser" Command="{Binding RefreshCommand}" Height="40" Padding="14,0" />
            </StackPanel>
        </Grid>

        <!-- Evaluations List -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Evaluations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Evaluation" x:CompileBindings="False">
                        <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Margin="0,0,0,14" BoxShadow="0 2 8 0 #08000000">
                            <Grid ColumnDefinitions="*,180,130,120,100">

                                <!-- Questionnaire & Stagiaire -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#ECFDF5" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconAward}" Width="14" Height="14" Foreground="{StaticResource SuccessGreenBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding QuestionnaireTitre}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconUtilisateurs}" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UtilisateurNom, StringFormat='Évalué : {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Score -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Score obtenu" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding ScoreTotal, StringFormat='{}{0:F1} points'}" Foreground="{StaticResource NavyPrimaryBrush}" FontWeight="Bold" FontSize="16" />
                                </StackPanel>

                                <!-- Pourcentage -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Taux de réussite" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding Pourcentage, StringFormat='{}{0:F1} %'}" Foreground="{StaticResource GoldDarkBrush}" FontWeight="Bold" FontSize="16" />
                                </StackPanel>

                                <!-- Statut -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="Statut" Foreground="{StaticResource TextMutedBrush}" FontSize="14" />
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Statut}" Foreground="{StaticResource SuccessGreenBrush}" FontWeight="Bold" FontSize="14" />
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <Button Grid.Column="4" Classes="outline" Content="Résultat →"
                                        Command="{Binding DataContext.OpenResultatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Height="34" Padding="12,0" FontSize="14" FontWeight="SemiBold"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
