<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="formatrack.App"
             xmlns:local="using:formatrack"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <!-- Color Palette: Institutional Military Navy & Gold Theme -->
        <Color x:Key="NavyDarkColor">#0D1B2A</Color>
        <Color x:Key="NavyPrimaryColor">#16294A</Color>
        <Color x:Key="NavyMediumColor">#1E3A66</Color>
        <Color x:Key="NavyHoverColor">#244578</Color>
        <Color x:Key="NavyLightColor">#2D5288</Color>

        <Color x:Key="GoldAccentColor">#D4AF37</Color>
        <Color x:Key="GoldHoverColor">#E2C258</Color>
        <Color x:Key="GoldDarkColor">#B38F24</Color>
        <Color x:Key="GoldMutedColor">#F5ECC8</Color>

        <Color x:Key="BackgroundPageColor">#F4F6FA</Color>
        <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
        <Color x:Key="FieldBackgroundColor">#F8FAFC</Color>
        <Color x:Key="BorderLightColor">#E2E8F0</Color>
        <Color x:Key="BorderMediumColor">#CBD5E1</Color>

        <Color x:Key="TextPrimaryColor">#0F172A</Color>
        <Color x:Key="TextSecondaryColor">#475569</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>
        <Color x:Key="TextLightColor">#94A3B8</Color>

        <Color x:Key="SuccessGreenColor">#10B981</Color>
        <Color x:Key="WarningAmberColor">#F59E0B</Color>
        <Color x:Key="DangerRedColor">#EF4444</Color>
        <Color x:Key="InfoBlueColor">#3B82F6</Color>

        <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}" />
        <SolidColorBrush x:Key="NavyPrimaryBrush" Color="{StaticResource NavyPrimaryColor}" />
        <SolidColorBrush x:Key="NavyMediumBrush" Color="{StaticResource NavyMediumColor}" />
        <SolidColorBrush x:Key="NavyHoverBrush" Color="{StaticResource NavyHoverColor}" />
        <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}" />

        <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccentColor}" />
        <SolidColorBrush x:Key="GoldHoverBrush" Color="{StaticResource GoldHoverColor}" />
        <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}" />
        <SolidColorBrush x:Key="GoldMutedBrush" Color="{StaticResource GoldMutedColor}" />

        <SolidColorBrush x:Key="BackgroundPageBrush" Color="{StaticResource BackgroundPageColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="{StaticResource FieldBackgroundColor}" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
        <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}" />

        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
        <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}" />

        <!-- Vector Icon Geometry Paths -->
        <StreamGeometry x:Key="IconDashboard">M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z</StreamGeometry>
        <StreamGeometry x:Key="IconFormations">M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z</StreamGeometry>
        <StreamGeometry x:Key="IconSessions">M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z</StreamGeometry>
        <StreamGeometry x:Key="IconUtilisateurs">M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z</StreamGeometry>
        <StreamGeometry x:Key="IconQuestionnaires">M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z</StreamGeometry>
        <StreamGeometry x:Key="IconEvaluations">M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z</StreamGeometry>
        <StreamGeometry x:Key="IconStatistiques">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
        <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
        <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeOff">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
        <StreamGeometry x:Key="IconLogout">M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconAward">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z</StreamGeometry>
        <StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconLocation">M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z</StreamGeometry>
        <StreamGeometry x:Key="IconClock">M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global Base Style Tweaks -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
            <Setter Property="Background" Value="{StaticResource BackgroundPageBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
        </Style>

        <!-- Button Themes -->
        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{StaticResource NavyPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavyHoverBrush}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavyDarkBrush}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.gold">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{StaticResource GoldAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.gold:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource GoldHoverBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource NavyDarkBrush}" />
        </Style>
        <Style Selector="Button.gold:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource GoldDarkBrush}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.outline">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource NavyPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BackgroundPageBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavyLightBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource NavyPrimaryBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FCA5A5" />
            <Setter Property="TextBlock.Foreground" Value="#991B1B" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource NavyPrimaryBrush}" />
        </Style>

        <!-- TextBox Styling -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource NavyMediumBrush}" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!-- ComboBox Styling -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Card Container Style -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #0A000000" />
        </Style>
    </Application.Styles>
</Application>